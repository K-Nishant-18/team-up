    { "id": "review", "lane": "owner", "col": 3, "type": "frontend", "label": "Review", "sublabel": "accept or reject", "tag": "owner only", "width": 128 },
    { "id": "persist", "lane": "api", "col": 4, "type": "backend", "label": "Save decision", "sublabel": "status + member", "width": 128 },
    { "id": "notified", "lane": "api", "col": 5, "type": "messagebus", "label": "Notify", "sublabel": "in-app badge", "width": 128 },
