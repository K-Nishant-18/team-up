  "cards": [
    {
      "dot": "cyan",
      "title": "Entities",
      "items": [
        "6 JPA entities across 4 packages: user, post, comment, request",
        "Identity-generated keys; fields mirror the DB schema 1:1",
        "Skills, links and timeline stored as @ElementCollection tables"
      ]
    },
    {
      "dot": "emerald",
      "title": "Relations",
      "items": [
        "User authors posts, comments and join requests (1:N)",
        "JoinRequest and Notification carry nullable FKs to Post",
        "5 notification types cover the join-request lifecycle"
      ]
    },
    {
      "dot": "violet",
      "title": "Access layer",
      "items": [
        "5 Spring Data repositories, one per aggregate root",
        "Controllers map onto entities: Me/User, Post, JoinRequest",
        "Responses use UserView/PostView DTOs, no password leaks"
      ]
    }
  ]
