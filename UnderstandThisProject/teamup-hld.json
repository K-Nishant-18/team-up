  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime",
      "items": [
        "Vite dev server on :5173 serves the SPA; Spring Boot API on :4000",
        "Stateless JWT filter chain, no sessions stored server-side",
        "CORS restricted to localhost:5173 / 4173 only"
      ]
    },
    {
      "dot": "emerald",
      "title": "Server",
      "items": [
        "7 controllers and ~23 endpoints with no service layer",
        "Spring Data JPA: 5 repositories, one per aggregate root",
        "JwtService signs tokens; ApiExceptionHandler handles errors"
      ]
    },
    {
      "dot": "rose",
      "title": "Data",
      "items": [
        "H2 in-memory with create-drop, rebuilt on every boot",
        "DataSeeder runs on startup: 5 users and 4 posts",
        "Offline demo store mirrors API responses in sessionStorage"
      ]
